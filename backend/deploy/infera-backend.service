[Unit]
Description=Infera backend (FastAPI)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/infera/backend
EnvironmentFile=/opt/infera/backend/.env
ExecStart=/opt/infera/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=5
# Model warmup at startup is slow (multi-minute on a cold cache) — give it
# real room before systemd decides the unit failed to start.
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
