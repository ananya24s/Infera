# LLM used ONLY for phrasing (sub-question drafting, claim segmentation, report prose).
ANTHROPIC_API_KEY=

# Optional: any email, no verification — moves OpenAlex requests into their
# faster "polite pool". Retrieval works fine without this.
INFERA_OPENALEX_CONTACT_EMAIL=

# Optional overrides — see app/config.py for defaults.
INFERA_NLI_MODEL=
INFERA_EMBEDDING_MODEL=
INFERA_RANKER_PATH=
INFERA_LLM_MODEL=

# Production: set to your deployed frontend's real origin(s), comma-separated.
# Defaults to localhost:5173 for local dev.
INFERA_ALLOWED_ORIGINS=

# Per-client-IP cap on /api/research calls. Defaults: 10 requests / 3600s.
INFERA_RATE_LIMIT_MAX_REQUESTS=
INFERA_RATE_LIMIT_WINDOW_S=
